import os
import subprocess
import ctypes
import sys
import uuid
import json

BACKUP_FILE = "backup_hwid.json"

def is_admin():
    try:
        return ctypes.windll.shell32.IsUserAnAdmin()
    except:
        return False

if not is_admin():
    print("[!] يا برو، لازم تشغل السكريبت كـ Administrator!")
    ctypes.windll.shell32.ShellExecuteW(None, "runas", sys.executable, __file__, None, 1)
    sys.exit()

